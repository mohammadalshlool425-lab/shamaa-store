# Development is local-only, not production. Copy to .env, never commit .env.
SHAMAA_ENV=development
SHAMAA_DB=data/marketplace.sqlite3
SHAMAA_DATA_DIR=data
SHAMAA_PUBLIC_URL=http://localhost:8000
SHAMAA_ALLOWED_HOSTS=localhost,127.0.0.1,*.e2b.app
# Optional illustrative catalog. Never enabled in production.
SHAMAA_DEMO_DATA=0
# file writes private .eml files in data/mail; DOES NOT send email.
SHAMAA_EMAIL_MODE=file
SHAMAA_SMTP_HOST=
SHAMAA_SMTP_PORT=587
SHAMAA_SMTP_USER=
SHAMAA_SMTP_PASSWORD=
SHAMAA_MAIL_FROM=noreply@example.com
# Required in production; generate: python -m server.cli generate-key
SHAMAA_ENCRYPTION_KEY=
# Separate key: keep a recovery copy OFF the server, inject only into backup jobs
SHAMAA_BACKUP_KEY=
